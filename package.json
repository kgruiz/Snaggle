{
    "name": "snaggle",
    "version": "1.0.0",
    "description": "Download content from specific websites via the extension popup.",
    "private": true,
    "type": "module",
    "scripts": 
    {
        "dev": "vite",
        "copy-vendor": "mkdir -p public/vendor && cp node_modules/jszip/dist/jszip.min.js public/vendor/ && cp node_modules/turndown/dist/turndown.js public/vendor/",
        "build": "npm run copy-vendor && vite build",
        "preview": "vite preview"
    },
    "keywords": 
    [
        "chrome",
        "extension",
        "downloader",
        "export",
        "typescript",
        "vite"
    ],
    "author": "Kaden Gruizenga",
    "dependencies": {
        "html2pdf.js": "^0.10.1",
        "jszip": "^3.10.1",
        "turndown": "^7.2.0"
    },
    "devDependencies": 
    {
        "@crxjs/vite-plugin": "^2.0.0-beta.32",
        "@types/node": "^22.14.1",
        "chrome-types": "^0.1.347",
        "typescript": "^5.8.3",
        "vite": "^6.2.6"
    }
}