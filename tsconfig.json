{
  "compilerOptions": {
    /* Base Options: */
    "esModuleInterop": true,
    "skipLibCheck": true,
    "target": "ES2017",
    "allowJs": false,
    "resolveJsonModule": true,
    "moduleResolution": "node",
    "module": "ES2020",

    /* Strict Type Checking: */
    "strict": true,
    "noImplicitAny": true, // Keep this true for better type safety
    "strictNullChecks": true,

    /* Module/Output Options: */
    "outDir": "./dist/js",
    "rootDir": "./js",
    "sourceMap": true,

    /* Library Options: */
    // Added "WebWorker" to allow globals like importScripts
    "lib": ["ES2020", "DOM", "DOM.Iterable", "WebWorker"],

    /* Advanced: */
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "js/**/*.ts" // Include all .ts files within the js directory
  ],
  "exclude": [
    "node_modules", // Exclude node_modules
    "dist" // Exclude the output directory
  ]
}