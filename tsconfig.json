{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable", "WebWorker"],
    "outDir": "./dist",
    "rootDir": "./src", // Keep rootDir pointing to src
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "sourceMap": true, // Enable source maps for easier debugging
    "resolveJsonModule": true,
    "moduleResolution": "node", // Or "bundler" if using Vite 5+ features heavily
    "types": ["chrome-types"],
    "isolatedModules": true,
    "baseUrl": ".", // Optional: Helps with path resolution if needed
    "paths": { // Optional: Define paths if needed for cleaner imports
        "@utils/*": ["src/utils/*"],
        "@modules/*": ["src/modules/*"],
        "@content/*": ["src/content/*"],
        "@background/*": ["src/background/*"],
        "@popup/*": ["src/popup/*"]
    }
  },
  "include": [
    "src/**/*.ts", // Include all .ts files in src
    "src/types/**/*.d.ts" // Explicitly include type definitions
    // Vite handles .css, .json etc., no need to include them here for TS
    ],
  "exclude": ["node_modules", "dist", "concat-out"] // Exclude build output and temp files
}