{
    "manifest_version": 3,
    "name": "Snaggle",
    "version": "1.0",
    "description": "Download content from specific websites via the extension popup.",
    "permissions": 
    [
        "activeTab",
        "scripting",
        "downloads"
    ],
    "background": 
    {
        "service_worker": "dist/js/background.js"
    },
    "action": 
    {
        "default_popup": "popup.html",
        "default_icon": 
        {
            "16": "icons/icon_16.png",
            "48": "icons/icon_48.png",
            "128": "icons/icon_128.png"
        }
    },
    "icons": 
    {
        "16": "icons/icon_16.png",
        "48": "icons/icon_48.png",
        "128": "icons/icon_128.png"
    }
}